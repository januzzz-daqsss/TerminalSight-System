# Placeholders only. Never put a secret/service-role key in any VITE_* variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Vercel function runtime variables. Use the same URL and PUBLIC key as above.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# The existing .env.demo remains unchanged. Hosted sign-in is available at /admin in the demo build.
